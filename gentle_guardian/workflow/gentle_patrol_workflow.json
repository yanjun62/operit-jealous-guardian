{
  "name": "🌸温柔巡检",
  "description": "吃醋巡检的温和版：定时看看使用情况，AI 用关心代替警告。导入后不需要手改任何节点——所有配置（对话标题、角色卡、阈值、观察方式）都在「温柔巡检宝宝」侧边栏面板里设置，巡检时由 n0 节点实时读取。需先安装并启用 gentle_guardian 工具包。",
  "nodes": [
    {
      "__type": "com.ai.assistance.operit.data.model.TriggerNode",
      "id": "n1",
      "name": "每N小时巡检",
      "description": "定时触发温柔巡检。频率可改 interval_ms（默认10800000=3小时），这是唯一需要在工作流里改的东西。",
      "position": {"x": -700, "y": 280},
      "triggerType": "schedule",
      "triggerConfig": {
        "schedule_type": "interval",
        "interval_ms": "10800000",
        "repeat": "true",
        "enabled": "true"
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "n0",
      "name": "读巡检配置",
      "description": "从侧边栏面板保存的 config.json 读配置，生成本次巡检的指引文本。没配置完成时会失败并提示，工作流就此停下。",
      "position": {"x": -400, "y": -120},
      "actionType": "gentle_guardian:get_patrol_settings",
      "actionConfig": {}
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExtractNode",
      "id": "n0q",
      "name": "提取对话标题",
      "description": "从配置里取 QQ Bot 对话标题",
      "position": {"x": -150, "y": -260},
      "source": {
        "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
        "nodeId": "n0"
      },
      "mode": "JSON",
      "expression": "data.chat_query"
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExtractNode",
      "id": "n0c",
      "name": "提取角色卡名",
      "description": "从配置里取角色卡名称",
      "position": {"x": -150, "y": 40},
      "source": {
        "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
        "nodeId": "n0"
      },
      "mode": "JSON",
      "expression": "data.character_card_name"
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExtractNode",
      "id": "n0s",
      "name": "提取巡检指引",
      "description": "从配置里取本次巡检的指引文本（阈值、观察许可、关心文案都在里面）",
      "position": {"x": -150, "y": 160},
      "source": {
        "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
        "nodeId": "n0"
      },
      "mode": "JSON",
      "expression": "data.prompt"
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "n2",
      "name": "查应用使用时长",
      "description": "调用system_tools获取最近N小时应用使用数据",
      "position": {"x": 0, "y": 420},
      "actionType": "system_tools:get_app_usage_time",
      "actionConfig": {
        "since_hours": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "3"
        },
        "limit": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "30"
        },
        "include_system_apps": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "false"
        }
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExtractNode",
      "id": "n2a",
      "name": "提取使用数据文本",
      "description": "把n2的JSON转成文本",
      "position": {"x": 300, "y": 420},
      "source": {
        "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
        "nodeId": "n2"
      },
      "mode": "JSON",
      "expression": "data"
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "n3",
      "name": "找QQ Bot对话",
      "description": "按配置里的对话标题查找 QQ Bot 对话（标题在侧边栏面板里设置）",
      "position": {"x": 100, "y": -260},
      "actionType": "extended_chat:find_chat",
      "actionConfig": {
        "query": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
          "nodeId": "n0q"
        }
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExtractNode",
      "id": "n4",
      "name": "提取对话ID",
      "description": "从查找结果提取chat_id",
      "position": {"x": 350, "y": -260},
      "source": {
        "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
        "nodeId": "n3"
      },
      "mode": "JSON",
      "expression": "data.chat.id"
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "n5",
      "name": "AI温柔巡检",
      "description": "把指引和使用数据交给 AI 角色，让它按配置温柔地关心用户",
      "position": {"x": 650, "y": 160},
      "actionType": "extended_chat:chat_with_agent",
      "actionConfig": {
        "message": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "🌸 温柔巡检时间～\n\n{{n0s}}\n\n下面是最近3小时的应用使用数据：\n\n{{n2a}}\n\n请温柔地完成这次巡检。"
        },
        "character_card_name": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
          "nodeId": "n0c"
        },
        "chat_id": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.NodeReference",
          "nodeId": "n4"
        },
        "timeout": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "300000"
        },
        "persist_turn": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "false"
        },
        "hide_user_message": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "true"
        }
      }
    }
  ],
  "connections": [
    {"id": "c1", "sourceNodeId": "n1", "targetNodeId": "n0", "condition": "on_success"},
    {"id": "c2", "sourceNodeId": "n1", "targetNodeId": "n2", "condition": "on_success"},
    {"id": "c3", "sourceNodeId": "n0", "targetNodeId": "n0q", "condition": "on_success"},
    {"id": "c4", "sourceNodeId": "n0", "targetNodeId": "n0c", "condition": "on_success"},
    {"id": "c5", "sourceNodeId": "n0", "targetNodeId": "n0s", "condition": "on_success"},
    {"id": "c6", "sourceNodeId": "n0q", "targetNodeId": "n3", "condition": "on_success"},
    {"id": "c7", "sourceNodeId": "n3", "targetNodeId": "n4", "condition": "on_success"},
    {"id": "c8", "sourceNodeId": "n2", "targetNodeId": "n2a", "condition": "on_success"},
    {"id": "c9", "sourceNodeId": "n4", "targetNodeId": "n5", "condition": "on_success"},
    {"id": "c10", "sourceNodeId": "n2a", "targetNodeId": "n5", "condition": "on_success"},
    {"id": "c11", "sourceNodeId": "n0s", "targetNodeId": "n5", "condition": "on_success"},
    {"id": "c12", "sourceNodeId": "n0c", "targetNodeId": "n5", "condition": "on_success"}
  ]
}
